APP_NAME="Eco-Loop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Locale settings (Indonesian)
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For local development (SQLite):
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# For production (MySQL) - uncomment and configure:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=eco_loop
# DB_USERNAME=your_username
# DB_PASSWORD=your_password

# For Vercel (PostgreSQL) - uncomment and configure:
# DB_CONNECTION=pgsql
# DB_HOST=your-postgres-host
# DB_PORT=5432
# DB_DATABASE=eco_loop
# DB_USERNAME=your_username
# DB_PASSWORD=your_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================
# QUEUE & CACHE CONFIGURATION
# ============================================
# For local development:
CACHE_STORE=database
QUEUE_CONNECTION=database

# For production (Redis) - uncomment and configure:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# CACHE_PREFIX=ecoloop_

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# MAIL CONFIGURATION
# ============================================
# For local development (logs emails):
MAIL_MAILER=log

# For development with Mailtrap - uncomment and configure:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_ENCRYPTION=tls

# For production with SMTP - uncomment and configure:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=your@email.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls

# For Vercel with Mailgun - uncomment and configure:
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=your-mailgun-domain
# MAILGUN_SECRET=your-mailgun-secret

MAIL_FROM_ADDRESS="hello@eco-loop.id"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# FILE STORAGE
# ============================================
FILESYSTEM_DISK=public

# AWS S3 (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=your-bucket-name
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# VITE
# ============================================
VITE_APP_NAME="${APP_NAME}"
